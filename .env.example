# Optional, free & instant (developer.ticketmaster.com): face-value prices + genres for Ticketmaster-sold shows
TICKETMASTER_API_KEY=
# Optional, free (seatgeek.com/account/develop): resale price comparison on show pages
SEATGEEK_CLIENT_ID=
# apply at api.setlist.fm — DO THIS FIRST, approval can take hours
SETLISTFM_API_KEY=
GROK_API_KEY=
# OpenAI-compatible. Non-reasoning model: ~1 s vs ~5 s for grok-4 (6 s cap)
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.20-0309-non-reasoning
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# All endpoints are green; set true (in web/.env.local — Next only reads web/) to demo on fixtures
NEXT_PUBLIC_USE_FIXTURES=false
